<Window x:Class="Synapse.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Synapse" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#313338">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>   <ColumnDefinition Width="240"/>  <ColumnDefinition Width="*"/>    </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E1F22">
            <StackPanel Margin="0,15,0,0">
                <Border Width="50" Height="50" CornerRadius="15" Background="#5865F2" Margin="0,0,0,10" Cursor="Hand">
                    <TextBlock Text="S" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Height="2" Width="32" Background="#313338" Margin="0,0,0,10" CornerRadius="1"/>
                <Border Width="50" Height="50" CornerRadius="25" Background="#313338" Margin="0,0,0,15" Cursor="Hand">
                    <TextBlock Text="MRX" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#2B2D31">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="#1E1F22" CornerRadius="4" Margin="10,10,10,10">
                    <TextBlock Text="Sohbet bul ya da başlat" Foreground="#949BA4" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"/>
                </Border>
                
                <StackPanel Grid.Row="1" Margin="10,5,10,0">
                    <Border Background="#404249" CornerRadius="4" Padding="10,8" Margin="0,0,0,2" Cursor="Hand">
                        <TextBlock Text="👋 Arkadaşlar" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="Transparent" CornerRadius="4" Padding="10,8" Margin="0,0,0,15" Cursor="Hand">
                        <TextBlock Text="🚀 Nitro Ana Sayfası" Foreground="#949BA4" FontWeight="SemiBold"/>
                    </Border>

                    <Grid Margin="5,0,0,10">
                        <TextBlock Text="DİREKT MESAJLAR" Foreground="#949BA4" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="+" Foreground="#949BA4" HorizontalAlignment="Right" FontSize="16" Cursor="Hand" Margin="0,-4,0,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10" Cursor="Hand">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#23A559">
                            <TextBlock Text="H" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Has Ekip" Foreground="#949BA4" FontWeight="SemiBold"/>
                            <TextBlock Text="7 Üye" Foreground="#949BA4" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10" Cursor="Hand">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#5865F2">
                            <TextBlock Text="E" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Emir" Foreground="#949BA4" FontWeight="SemiBold"/>
                            <TextBlock Text="FiveM" Foreground="#949BA4" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="2" Background="#232428">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#23A559">
                            <TextBlock Text="Y" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Yiğit" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="Çevrimiçi" Foreground="#23A559" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#1F2023" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                    <TextBlock Text="👋 Arkadaşlar" Foreground="White" FontWeight="Bold" FontSize="15" Margin="0,0,15,0"/>
                    <Border Width="1" Height="24" Background="#3F4147" Margin="0,0,15,0"/>
                    <TextBlock Text="Çevrim içi" Foreground="White" Background="#404249" Padding="8,4" Margin="0,0,15,0" Cursor="Hand"/>
                    <TextBlock Text="Tümü" Foreground="#B5BAC1" Padding="8,4" Margin="0,0,15,0" Cursor="Hand"/>
                    <TextBlock Text="Bekleyen" Foreground="#B5BAC1" Padding="8,4" Margin="0,0,15,0" Cursor="Hand"/>
                    <Border Background="#23A559" CornerRadius="4" Padding="8,4" Cursor="Hand">
                        <TextBlock Text="Arkadaş Ekle" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="20,20,20,0">
                    <StackPanel>
                        <Border Background="#1E1F22" CornerRadius="4" Padding="10" Margin="0,0,0,20">
                            <TextBlock Text="Ara" Foreground="#949BA4"/>
                        </Border>
                        
                        <TextBlock Text="Çevrim içi — 2" Foreground="#949BA4" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                        <Border Height="1" Background="#3F4147" Margin="0,0,0,10"/>

                        <Border BorderBrush="#3F4147" BorderThickness="0,1,0,0" Padding="0,10" Cursor="Hand">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#F0B232">
                                        <TextBlock Text="K" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="! kai" Foreground="White" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="🎮 The Last of Us™ Part I" Foreground="#B5BAC1" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#3F4147" BorderThickness="0,1,0,0" Padding="0,10" Cursor="Hand">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#ED4245">
                                        <TextBlock Text="S" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="SERDAR|41" Foreground="White" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="Bende portakallıyım MALATYA" Foreground="#B5BAC1" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="#1F2023" BorderThickness="1,0,0,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Şu An Etkin" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"/>
                        
                        <Border Background="#2B2D31" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#1F2023" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#ED4245">
                                        <TextBlock Text="S" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="SERDAR|41" Foreground="White" FontWeight="Bold"/>
                                        <TextBlock Text="Ekranını paylaşıyor" Foreground="#B5BAC1" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Height="100" Background="#1E1F22" CornerRadius="4">
                                    <TextBlock Text="YAYINDA" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="#2B2D31" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#1F2023" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#23A559">
                                    <TextBlock Text="K" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="K a a n" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="Spotify Dinliyor" Foreground="#B5BAC1" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>